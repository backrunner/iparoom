{
  "name": "iparoom-cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/iparoom.git",
    "directory": "packages/cli"
  },
  "description": "Upload Xcode IPA builds and create iOS installation links with IPA Room",
  "type": "module",
  "bin": {
    "iparoom": "./bin/iparoom.mjs",
    "iparoom-mcp": "./bin/iparoom-mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --check bin/iparoom.mjs",
    "prepack": "node ../../scripts/package-cli.mjs --build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "bplist-parser": "0.5.0",
    "commander": "15.0.0",
    "plist": "5.0.0",
    "qrcode": "1.5.4",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  }
}
