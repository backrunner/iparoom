# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IPAROOM_ADMIN_TOKEN=
# Bind all IPv4 interfaces by default. Set 127.0.0.1 or a local IP to restrict listening.
IPAROOM_LAN_HOST=0.0.0.0
# DNS hostname/IP in generated links; must resolve to this host on test devices.
IPAROOM_HOSTNAME=
IPAROOM_BASE_URL=
IPAROOM_DATA_DIR=./data
IPAROOM_MAX_UPLOAD_BYTES=1073741824
BODY_SIZE_LIMIT=1G
# Docker HTTP: IPAROOM_HOSTNAME=192.168.1.10
#              IPAROOM_BASE_URL=http://192.168.1.10:3000
# Docker HTTPS overlay uses https://<IPAROOM_HOSTNAME>:8443

# HTTP MCP only: supply a separate random token of at least 24 characters.
IPAROOM_MCP_TOKEN=
